# Ejemplos sin secretos. Copia a .env (ignorado por Git) y completa. Las variables VITE_* son públicas (van al cliente).
VITE_API_BASE_URL=https://<api-https-real>

# MLflow persistente del equipo (DagsHub). La URI no es secreta; usuario y token sí.
# Token: DagsHub -> Settings -> Tokens. Cargar antes de entrenar: set -a; source .env; set +a
MLFLOW_TRACKING_URI=https://dagshub.com/mamezquita/Warehouse-Rush.mlflow
MLFLOW_TRACKING_USERNAME=<tu-usuario-dagshub>
MLFLOW_TRACKING_PASSWORD=<tu-token-dagshub>
# Solo para una prueba local deliberada (sqlite:///mlflow.db, no compartido): MLFLOW_PERMITIR_LOCAL=1

# DVC: remoto `r2` ya en .dvc/config; credenciales con `dvc remote modify --local r2 ...` (sin credenciales en Git)
