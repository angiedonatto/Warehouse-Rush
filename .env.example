# Ejemplos sin secretos. Copiar a .env (ignorado por Git) y completar. Las variables VITE_* son públicas (van al cliente).
VITE_API_BASE_URL=https://<api-https-real>
# Backend / worker (nunca en el frontend)
# MLflow persistente en DagsHub (decisión 2026-11-18); usuario y token solo en .env
MLFLOW_TRACKING_URI=https://dagshub.com/mamezquita/Warehouse-Rush.mlflow
MLFLOW_TRACKING_USERNAME=<usuario-dagshub>
MLFLOW_TRACKING_PASSWORD=<token-dagshub>
# DVC_REMOTE: remoto r2 (Cloudflare R2) ya está en .dvc/config; las credenciales van en .dvc/config.local (sin Git)
